{
  // Static assets only. VitePress emits a real HTML file per page, so unlike
  // placepin.org there is no SPA fallback here: an unknown path is a genuine
  // 404, and the built 404.html is the right answer for it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placepin-about",
  "compatibility_date": "2026-08-25",

  "assets": {
    "directory": "./docs/.vitepress/dist",
    "not_found_handling": "404-page"
  }
}
